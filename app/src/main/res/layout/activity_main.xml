<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="실시간 자막"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="① 다른 앱 위에 표시 권한 켜기" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="어떤 소리를 자막으로 만들까요?"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/sourceGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/srcPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="폰에서 나오는 소리 (유튜브, 영상 등)"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/srcMic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="주변 소리 (마이크 – 대화, 강의 등)"
                android:textSize="16sp" />
        </RadioGroup>

        <TextView
            android:id="@+id/fontLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="18sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/fontSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="34" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="자막 위치"
            android:textSize="18sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/posGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/posTop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="위" />

            <RadioButton
                android:id="@+id/posMiddle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="가운데" />

            <RadioButton
                android:id="@+id/posBottom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="아래" />
        </RadioGroup>

        <TextView
            android:id="@+id/bgLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="18sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/bgSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100" />

        <TextView
            android:id="@+id/linesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="18sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/linesSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="3" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="28dp"
            android:text="② 자막 시작"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="자막 끄기" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="4dp"
            android:text="• 폰 소리 모드: 시작을 누르면 화면 녹화 허용 창이 떠요. &quot;전체 화면&quot;을 고르고 시작을 누르세요. 화면은 녹화·저장되지 않고 소리만 자막으로 바뀝니다.\n• 시작한 뒤 유튜브를 열면 영상 위에 자막이 떠요. 자막은 터치를 막지 않아요.\n• 끄려면 이 화면의 [자막 끄기] 또는 알림창의 [끄기]를 누르세요.\n• 인식은 인터넷 없이 폰 안에서만 처리됩니다.\n• 일부 앱(넷플릭스 등)은 소리 캡처를 막아서 자막이 안 나올 수 있어요."
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
